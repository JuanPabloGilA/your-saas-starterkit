---
interface Props {
  companyName: string;
  currentYear: number;
}

const { companyName, currentYear } = Astro.props;
---

<footer class="border-t bg-background/80 backdrop-blur-sm py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="border-t pt-8 text-center text-muted-foreground">
      <p>&copy; {currentYear} {companyName}. All rights reserved.</p>
    </div>
  </div>
</footer>
