---
import Analytics from '@/components/Analytics.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Your SaaS Starter Kit',
  description = 'A modern platform that helps you create, deploy, and scale your applications with confidence and ease.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
